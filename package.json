{
  "name": "heyo",
  "version": "0.1.0",
  "private": true,
  "description": "Forgiving clicks: a missed click on empty space goes to the element you aimed for",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check . && tsc --noEmit && node loop/cli.mjs lint src/decision",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "node .claude/skills/verify-heyo/scripts/verify.mjs",
    "score": "node scorer/cli.mjs score",
    "gates": "node scorer/cli.mjs gates",
    "synth": "node scorer/cli.mjs synth",
    "scripted": "node scripted/cli.mjs",
    "loop": "node loop/cli.mjs run",
    "lint:decision": "node loop/cli.mjs lint src/decision",
    "e2e:live": "playwright test --config playwright.live.config.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/recursive": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "preact": "^11.2.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
